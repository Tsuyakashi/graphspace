# Скопировать в .env рядом с compose.yaml. В git .env не попадает.

# Cloudflare Access: домен команды (он же iss в JWT) и AUD-тег приложения из Zero Trust → Access → Applications.
CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
CF_ACCESS_AUD=

# Чей ./data: id -u / id -g пользователя ВМ. Для rootless Docker — 0 и 0.
GRAPHSPACE_UID=1000
GRAPHSPACE_GID=1000
