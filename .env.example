# Скопировать в .env: его читает `npm start` (node --env-file-if-exists). В git .env не попадает.
# Значения — под локальный compose.yaml.

AUTH_MODE=dev
DATABASE_URL=postgres://graphspace:graphspace@127.0.0.1:5432/graphspace
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=graphspace
S3_SECRET_KEY=graphspace-dev-secret

# Вход как на проде вместо AUTH_MODE=dev:
# CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# CF_ACCESS_AUD=
