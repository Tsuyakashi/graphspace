{
  "name": "graphspace",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "build": "npm --prefix web run build",
    "dev": "npm --prefix web run dev",
    "seed": "node --env-file-if-exists=.env server/seed.mjs",
    "test": "node --test tests/api.test.mjs tests/auth.test.mjs tests/access.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "setup": "npm install && npm --prefix web install && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
